# Copy this file to .env and fill in your real keys
# NEVER push .env to GitHub — it is blocked by .gitignore

# ── Groq API (free at console.groq.com) ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Tavily Search API (free at tavily.com) ───────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── GitHub (Settings → Developer Settings → Personal Access Tokens → Classic)
# Required scopes: repo (full access)
GITHUB_TOKEN=your_github_token_here

# ── GitHub Repo (format: username/repo-name) ─────────────────────────────────
GITHUB_REPO=prasadmanas8b-debug/ai-agent-project

# ── Email Agent (Gmail SMTP) ──────────────────────────────────────────────────
# For Gmail: enable 2FA → Google Account → Security → App Passwords → generate one
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

# ── SMTP Settings (defaults work for Gmail) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Optional: default recipient for quick sends ───────────────────────────────
EMAIL_RECIPIENT=default_recipient@example.com
