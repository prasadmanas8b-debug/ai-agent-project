# Copy this file to .env and fill in your values

# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# Model overrides (optional — defaults are set in config/settings.py)
# MODEL_DEFAULT=llama-3.3-70b-versatile
# MODEL_SCOUT=meta-llama/llama-4-scout-17b-16e-instruct
# MAX_TOKENS_DEFAULT=4096
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=3

# ── Search ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
# TAVILY_MAX_RESULTS=5

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_username/your_repo_name

# ── Email (SMTP/IMAP) ─────────────────────────────────────────────────────────
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ── Database ──────────────────────────────────────────────────────────────────
# DB_TYPE options: sqlite (default) | postgresql | mysql
DB_TYPE=sqlite
DB_SQLITE_PATH=database.db
DB_READ_ONLY=false
DB_AUDIT_LOG=outputs/db_audit.log

# For PostgreSQL or MySQL (leave blank if using SQLite):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=your_database_name
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=ai-agent-system
# ENABLE_TRACING=false
# METRICS_PORT=9090
